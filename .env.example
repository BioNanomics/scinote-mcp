# SciNote instance base URL (no trailing slash)
SCINOTE_BASE_URL=https://scinote-dev.os.mieweb.org

# Auth option A (simplest): per-user API key, sent as the `Api-Key` header.
# Requires CORE_API_KEY_ENABLED=true on the SciNote server.
# Each tech generates their own key; NEVER share keys between users
# (attribution in the audit trail depends on it).
SCINOTE_API_KEY=

# Auth option B: JWT bearer token (Authorization: Bearer ...). Leave API key
# blank to use this. See README "Authentication".
SCINOTE_JWT=

# There is no team/project/experiment here on purpose. The tech picks one at
# runtime with the set_scope tool ("work on the GingiGuard assay"), and it
# sticks for the rest of the session.

# --- HTTP transport (npm run serve) -----------------------------------------
# nginx terminates TLS at https://scinote-mcp.os.mieweb.org/ and proxies here.
# Use 127.0.0.1 when the proxy is on this host, 0.0.0.0 when it isn't.
SCINOTE_MCP_PORT=3001
SCINOTE_MCP_BIND=0.0.0.0

# DNS rebinding protection. Must list every hostname the proxy forwards as Host.
SCINOTE_MCP_ALLOWED_HOSTS=scinote-mcp.os.mieweb.org,localhost:3001,127.0.0.1:3001

# Browser origins allowed to call the endpoint (the Ozwell app). Empty = no CORS.
SCINOTE_MCP_ALLOWED_ORIGINS=

# Over HTTP each request must carry its own SciNote credential
# (X-SciNote-Api-Key or Authorization: Bearer <jwt>). Setting this to true lets
# credential-less callers act as the .env user - local testing ONLY, never on a
# publicly reachable deployment.
SCINOTE_MCP_ALLOW_SHARED_CREDENTIAL=false
